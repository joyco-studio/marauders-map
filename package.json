{
  "name": "lab-template-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/map/*.test.ts",
    "bake:fonts": "lettra bake public/map/fonts/tangerine-bold.ttf --charset ascii --size 64 --pxrange 8 --out public/map/fonts/tangerine && lettra bake public/map/fonts/cinzel.ttf --weights 400 --charset ascii --size 64 --pxrange 8 --out public/map/fonts/cinzel",
    "bake:art": "node scripts/bake-art.mjs && tsx scripts/prepare-fallback.mts",
    "test:sdf": ".context/sdf-venv/bin/python scripts/test-sdf.py"
  },
  "dependencies": {
    "@joycostudio/susano": "^1.1.0",
    "@joycostudio/xyz": "^1.3.0",
    "@tweakpane/core": "^2.0.5",
    "lettra": "^0.3.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.186.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "msdf-bmfont-xml": "^2.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "sharp": "^0.34.5"
  }
}
